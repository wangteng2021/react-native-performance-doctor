# 复制到 .env(本地)或者通过 pm2 ecosystem 注入到生产环境
# backend/server.js 当前支持的环境变量

# Node 监听端口,默认 3000
PORT=3000

# CORS 白名单,逗号分隔。
# 生产环境必须显式设置成你的域名,不要用 *。
# 例:
#   CORS_ALLOWED_ORIGINS=https://your-domain.com
#   CORS_ALLOWED_ORIGINS=https://your-domain.com,https://admin.your-domain.com
# 留空 或 设为 * 时放开所有来源(仅限本地开发)
CORS_ALLOWED_ORIGINS=*

# Embed 会话签名密钥。生产环境必须固定配置,否则 Node 重启后已打开的游戏会话会失效。
# 建议使用 32 字节以上随机字符串,不要提交真实值。
EMBED_SESSION_SECRET=change-me-to-a-long-random-secret

# 多 repo / 生产部署时的静态目录。默认布局为 /www/wwwroot/wtns/{admin,official,games/<gameId>}。
# 老 monorepo 本地开发会自动 fallback 到 ./frontend 和 ./admin。
# WTNS_ADMIN_DIR=/www/wwwroot/wtns/admin
# WTNS_OFFICIAL_DIR=/www/wwwroot/wtns/official
# WTNS_GAMES_ROOT=/www/wwwroot/wtns/games

# Baishun A 服务对接。BAISHUN_BASE_URL 留空时关闭对接,FishStar 使用 YB 内部余额。
# 这些密钥只允许放在服务端环境变量,不要写入静态文件、URL 或 App bridge payload。
# BAISHUN_BASE_URL=https://a-service.example.com
# BAISHUN_PATH_PREFIX=/callback/baishun
# BAISHUN_APP_ID=8146186998
# BAISHUN_PROVIDER_NAME=bobi
# BAISHUN_GAME_ID=1022
# BAISHUN_CURRENCY_TYPE=0
# BAISHUN_SIGNATURE_SECRET=replace-with-baishun-body-sign-secret
# BAISHUN_HEADER_SIGN_SECRET=replace-with-baishun-header-sign-secret
# BAISHUN_TIMEOUT_MS=5000
# BAISHUN_TOKEN_TTL_MS=1200000
